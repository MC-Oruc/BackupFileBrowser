{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0.1",
	"FriendlyName": "Backup File Browser",
	"Description": "Shows project backup files in the Content Browser.",
	"Category": "Editor",
	"CreatedBy": "MC-Oruc",
	"CreatedByURL": "https://github.com/MC-Oruc",
	"DocsURL": "https://github.com/MC-Oruc/BackupFileBrowser#readme",
	"SupportURL": "https://github.com/MC-Oruc/BackupFileBrowser/issues",
	"EngineVersion": "5.7.0",
	"EnabledByDefault": true,
	"EditorOnly": true,
	"CanContainContent": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "BackupFileBrowserEditor",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"TargetAllowList": [
				"Editor"
			]
		}
	],
	"Plugins": [
		{
			"Name": "ContentBrowserFileDataSource",
			"Enabled": true
		}
	]
}
